package app

import (
	"fmt"
	"strings"

	g "github.com/gyoumi/grove"
	"github.com/gyoumi/overlap/ui"
)

// rosterRow is a sample row type for the DataTable demo.
type rosterRow struct {
	name string
	role string
	age  int
}

// ComponentsPage is a gallery that renders every grove ui component, so the
// whole library is dogfooded and visually testable inside overlap — including
// the pieces a scheduling app would never use on its own.
func ComponentsPage() *g.Node {
	sel, setSel := g.UseState("")
	combo, setCombo := g.UseState("")
	radio, setRadio := g.UseState("standard")
	toggles, setToggles := g.UseState([]string{"bold"})
	slider, setSlider := g.UseState(40.0)
	otp, setOtp := g.UseState("")
	dlgOpen, setDlg := g.UseState(false)
	alertOpen, setAlert := g.UseState(false)
	sheetOpen, setSheet := g.UseState(false)
	drawerOpen, setDrawer := g.UseState(false)
	menuOpen, setMenu := g.UseState(false)

	return g.Div(g.Class("flex flex-col gap-10 py-6 animate-rise"),
		g.Div(g.Class("flex flex-col gap-1"),
			ui.TypographyH2(g.Class("border-0 p-0 text-2xl"), "Component gallery"),
			ui.TypographyMuted("Every grove ui component, themed and dark-mode ready."),
		),

		componentSection("Buttons",
			g.Div(g.Class("flex flex-wrap items-center gap-2"),
				ui.Button(ui.ButtonProps{}, "Default"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonSecondary}, "Secondary"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonDestructive}, "Destructive"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline}, "Outline"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonGhost}, "Ghost"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonLink}, "Link"),
				ui.Button(ui.ButtonProps{Size: ui.ButtonSizeIcon}, ui.Icon("plus")),
				ui.Button(ui.ButtonProps{Disabled: true}, "Disabled"),
			),
			ui.ButtonGroup(
				ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline}, "Day"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline}, "Week"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline}, "Month"),
			),
		),

		componentSection("Badges",
			g.Div(g.Class("flex flex-wrap items-center gap-2"),
				ui.Badge(ui.BadgeProps{}, "Default"),
				ui.Badge(ui.BadgeProps{Variant: ui.BadgeSecondary}, "Secondary"),
				ui.Badge(ui.BadgeProps{Variant: ui.BadgeDestructive}, "Destructive"),
				ui.Badge(ui.BadgeProps{Variant: ui.BadgeOutline}, "Outline"),
				ui.Kbd("⌘"), ui.Kbd("K"),
			),
		),

		componentSection("Toggles",
			g.Div(g.Class("flex flex-wrap items-center gap-4"),
				ui.ToggleGroup(ui.ToggleGroupProps{
					Multiple: true, Variant: ui.ToggleOutline, Value: toggles,
					OnChange: setToggles,
				},
					ui.ToggleGroupItem{Value: "bold", Children: []any{g.Strong("B")}},
					ui.ToggleGroupItem{Value: "italic", Children: []any{g.Em("I")}},
					ui.ToggleGroupItem{Value: "underline", Children: []any{g.Span(g.Class("underline"), "U")}},
				),
				ui.TypographyMuted(fmt.Sprintf("on: %v", toggles)),
			),
		),

		componentSection("Form controls",
			g.Div(g.Class("grid gap-5 sm:grid-cols-2"),
				ui.Field(
					ui.FieldLabel("g-name", "Name"),
					ui.Input(ui.InputProps{ID: "g-name", Placeholder: "Ada Lovelace"}),
					ui.FieldDescription("Your full name."),
				),
				ui.Field(
					ui.FieldLabel("", "Search"),
					ui.InputGroup(
						ui.InputGroupAddon(ui.Icon("search")),
						ui.Input(ui.InputProps{Placeholder: "Search…"}),
						ui.InputGroupAddon(ui.Kbd("⌘K")),
					),
				),
				ui.Field(
					ui.FieldLabel("", "Select (styled)"),
					ui.Select(ui.SelectProps{
						Value: sel, OnChange: setSel, Placeholder: "Pick a fruit",
						Options: []ui.SelectOption{{Value: "apple", Label: "Apple"}, {Value: "banana", Label: "Banana"}, {Value: "cherry", Label: "Cherry"}},
					}),
				),
				ui.Field(
					ui.FieldLabel("", "Combobox (searchable)"),
					ui.Combobox(ui.ComboboxProps{
						Value: combo, OnChange: setCombo, Placeholder: "Pick a framework", SearchPlaceholder: "Search frameworks…",
						Options: []ui.SelectOption{{Value: "grove", Label: "grove"}, {Value: "react", Label: "React"}, {Value: "vue", Label: "Vue"}, {Value: "svelte", Label: "Svelte"}, {Value: "solid", Label: "Solid"}},
					}),
				),
				ui.Field(
					ui.FieldLabel("", "Native select"),
					ui.NativeSelect(ui.NativeSelectProps{
						Placeholder: "Choose…",
						Options:     []ui.SelectOption{{Value: "s", Label: "Small"}, {Value: "m", Label: "Medium"}, {Value: "l", Label: "Large"}},
					}),
				),
				ui.Field(
					ui.FieldLabel("", "Message"),
					ui.Textarea(ui.TextareaProps{Placeholder: "Write something…", Rows: 3}),
				),
				ui.Field(
					ui.FieldLabel("", fmt.Sprintf("Slider (%d)", int(slider))),
					ui.Slider(ui.SliderProps{Value: slider, OnChange: setSlider}),
				),
			),
			g.Div(g.Class("flex flex-wrap items-center gap-6"),
				ui.Label("", g.Span(g.Class("flex items-center gap-2"), ui.Checkbox(ui.CheckboxProps{}), "Accept terms")),
				ui.Label("", g.Span(g.Class("flex items-center gap-2"), ui.Switch(ui.SwitchProps{}), "Notifications")),
				ui.RadioGroup(ui.RadioGroupProps{Value: radio, OnChange: setRadio, Class: "grid-flow-col"},
					ui.RadioItem{Value: "standard", Label: "Standard"},
					ui.RadioItem{Value: "express", Label: "Express"},
				),
			),
			g.Div(g.Class("flex items-center gap-3"),
				ui.InputOTP(ui.InputOTPProps{Value: otp, Length: 4, OnChange: setOtp}),
				ui.TypographyMuted(fmt.Sprintf("code: %s", otp)),
			),
		),

		componentSection("Feedback",
			ui.Alert(ui.AlertProps{}, ui.AlertTitle("Heads up"), ui.AlertDescription("This is an informational alert.")),
			ui.Alert(ui.AlertProps{Variant: ui.AlertDestructive}, ui.AlertTitle("Error"), ui.AlertDescription("Something went wrong.")),
			g.Div(g.Class("flex items-center gap-4"),
				ui.Progress(66, "max-w-xs"),
				ui.Spinner("size-5"),
				ui.Badge(ui.BadgeProps{Variant: ui.BadgeSecondary}, ui.Icon("circle-check", "size-3 text-emerald-500"), "Saved"),
			),
			g.Div(g.Class("flex items-center gap-3"),
				ui.Skeleton("size-10 rounded-full"),
				g.Div(g.Class("flex flex-col gap-2"), ui.Skeleton("h-3 w-32"), ui.Skeleton("h-3 w-24")),
			),
		),

		componentSection("Data & display",
			ui.Table(
				ui.TableHeader(ui.TableRow(ui.TableHead("Name"), ui.TableHead("Role"), ui.TableHead("Status"))),
				ui.TableBody(
					ui.TableRow(ui.TableCell(g.Strong("Ada")), ui.TableCell("Engineer"), ui.TableCell(ui.Badge(ui.BadgeProps{Variant: ui.BadgeSecondary}, "Active"))),
					ui.TableRow(ui.TableCell(g.Strong("Lin")), ui.TableCell("Designer"), ui.TableCell(ui.Badge(ui.BadgeProps{Variant: ui.BadgeOutline}, "Away"))),
				),
			),
			ui.Item(
				ui.ItemMedia(ui.Avatar(ui.AvatarProps{Name: "Ada Lovelace"})),
				ui.ItemContent(ui.ItemTitle("Ada Lovelace"), ui.ItemDescription("ada@analytical.engine")),
				ui.ItemActions(ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline, Size: ui.ButtonSizeSm}, "Invite")),
			),
			ui.Breadcrumb(ui.BreadcrumbList(
				ui.BreadcrumbItem(ui.BreadcrumbLink("#", "Home")),
				ui.BreadcrumbSeparator(),
				ui.BreadcrumbItem(ui.BreadcrumbLink("#", "Components")),
				ui.BreadcrumbSeparator(),
				ui.BreadcrumbItem(ui.BreadcrumbPage("Gallery")),
			)),
			ui.Pagination(ui.PaginationContent(
				ui.PaginationItem(ui.PaginationPrevious("#")),
				ui.PaginationItem(ui.PaginationLink("#", false, "1")),
				ui.PaginationItem(ui.PaginationLink("#", true, "2")),
				ui.PaginationItem(ui.PaginationLink("#", false, "3")),
				ui.PaginationItem(ui.PaginationNext("#")),
			)),
		),

		componentSection("Data table",
			ui.DataTable(ui.DataTableProps[rosterRow]{
				Columns: []ui.Column[rosterRow]{
					{Header: "Name", Cell: func(r rosterRow) any { return g.Strong(r.name) },
						Less: func(a, b rosterRow) bool { return a.name < b.name }},
					{Header: "Role", Cell: func(r rosterRow) any { return r.role }},
					{Header: "Age", Class: "text-right", Cell: func(r rosterRow) any { return fmt.Sprint(r.age) },
						Less: func(a, b rosterRow) bool { return a.age < b.age }},
				},
				Rows: []rosterRow{
					{"Ada Lovelace", "Engineer", 36},
					{"Grace Hopper", "Admiral", 85},
					{"Alan Turing", "Researcher", 41},
					{"Katherine Johnson", "Mathematician", 101},
					{"Linus Torvalds", "Maintainer", 54},
					{"Margaret Hamilton", "Director", 88},
				},
				Filter: func(r rosterRow, q string) bool {
					hay := strings.ToLower(fmt.Sprintf("%s %s %d", r.name, r.role, r.age))
					return strings.Contains(hay, strings.ToLower(q))
				},
				PageSize: 4,
			}),
		),

		componentSection("Disclosure",
			ui.Tabs(ui.TabsProps{},
				ui.Tab{Value: "overview", Label: "Overview", Content: []any{ui.TypographyMuted("The overview panel.")}},
				ui.Tab{Value: "activity", Label: "Activity", Content: []any{ui.TypographyMuted("Recent activity here.")}},
				ui.Tab{Value: "settings", Label: "Settings", Content: []any{ui.TypographyMuted("Settings live here.")}},
			),
			ui.Accordion(ui.AccordionProps{DefaultOpen: []string{"a"}},
				ui.AccordionItem{Value: "a", Title: "What is overlap?", Content: []any{g.Span("A when2meet-style availability matcher.")}},
				ui.AccordionItem{Value: "b", Title: "How does it work?", Content: []any{g.Span("Paint your availability on a grid.")}},
			),
			ui.Collapsible(ui.CollapsibleProps{},
				g.Span(g.Class("text-sm font-medium"), "Advanced options ", ui.Icon("chevron-down", "size-4")),
				ui.TypographyMuted("Hidden details revealed on toggle."),
			),
		),

		componentSection("Command",
			g.Div(g.Class("max-w-md overflow-hidden rounded-lg border shadow-md"),
				ui.Command(ui.CommandProps{Placeholder: "Type a command or search…"},
					ui.CommandGroup{Heading: "Suggestions", Items: []ui.CommandItem{
						{Value: "Calendar", Label: g.Span(g.Class("flex items-center gap-2"), ui.Icon("calendar", "size-4"), "Calendar")},
						{Value: "Search", Label: g.Span(g.Class("flex items-center gap-2"), ui.Icon("search", "size-4"), "Search")},
						{Value: "Clock", Label: g.Span(g.Class("flex items-center gap-2"), ui.Icon("clock", "size-4"), "Clock")},
					}},
					ui.CommandGroup{Heading: "Settings", Items: []ui.CommandItem{
						{Value: "Profile"},
						{Value: "Billing"},
					}},
				),
			),
		),

		componentSection("Toasts",
			g.Div(g.Class("flex flex-wrap items-center gap-2"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline, OnClick: func(*g.Event) {
					ui.Toast("Saved", ui.ToastOptions{Description: "Your changes are saved."})
				}}, "Show toast"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline, OnClick: func(*g.Event) {
					ui.Toast("Event created", ui.ToastOptions{Description: "Standup · 5 days", Variant: ui.ToastSuccess})
				}}, "Success"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline, OnClick: func(*g.Event) {
					ui.Toast("Something went wrong", ui.ToastOptions{Description: "Could not save the event.", Variant: ui.ToastDestructive})
				}}, "Error"),
			),
		),

		componentSection("Overlays",
			g.Div(g.Class("flex flex-wrap items-center gap-2"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline, OnClick: func(*g.Event) { setDlg(true) }}, "Dialog"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline, OnClick: func(*g.Event) { setAlert(true) }}, "Alert dialog"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline, OnClick: func(*g.Event) { setSheet(true) }}, "Sheet"),
				ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline, OnClick: func(*g.Event) { setDrawer(true) }}, "Drawer"),
				ui.Dropdown(ui.DropdownProps{Open: menuOpen, OnClose: func() { setMenu(false) }},
					ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline, OnClick: func(*g.Event) { setMenu(!menuOpen) }}, "Menu ", ui.Icon("chevron-down", "size-4")),
					ui.DropdownLabel("Actions"),
					ui.DropdownItem(ui.DropdownItemProps{}, "Duplicate"),
					ui.DropdownItem(ui.DropdownItemProps{}, "Archive"),
					ui.DropdownSeparator(),
					ui.DropdownItem(ui.DropdownItemProps{Class: "text-destructive"}, "Delete"),
				),
			),
			ui.Menubar(ui.MenubarProps{},
				ui.MenubarMenu{Label: "File", Items: []any{
					ui.DropdownItem(ui.DropdownItemProps{}, "New"),
					ui.DropdownItem(ui.DropdownItemProps{}, "Open"),
				}},
				ui.MenubarMenu{Label: "Edit", Items: []any{
					ui.DropdownItem(ui.DropdownItemProps{}, "Undo"),
					ui.DropdownItem(ui.DropdownItemProps{}, "Redo"),
				}},
			),
			ui.NavigationMenu(ui.NavigationMenuProps{},
				ui.NavMenuItem{Label: "Docs", Href: "https://github.com/gyoumi/grove", Target: "_blank"},
				ui.NavMenuItem{Label: "Projects", Panel: []any{
					g.Div(g.Class("flex w-48 flex-col gap-1"),
						g.A(g.Class("rounded px-2 py-1.5 text-sm hover:bg-accent"),
							g.Href("https://github.com/gyoumi/grove"), g.Attr("target", "_blank"), g.Attr("rel", "noopener noreferrer"),
							"grove framework"),
						g.A(g.Class("rounded px-2 py-1.5 text-sm hover:bg-accent"),
							g.Href("https://github.com/gyoumi/warchest-errors"), g.Attr("target", "_blank"), g.Attr("rel", "noopener noreferrer"),
							"warchest errors"),
					),
				}},
			),
			ui.ContextMenu(ui.ContextMenuProps{},
				g.Div(g.Class("flex h-20 items-center justify-center rounded-md border border-dashed text-sm text-muted-foreground"), "Right-click here"),
				ui.DropdownItem(ui.DropdownItemProps{}, "Cut"),
				ui.DropdownItem(ui.DropdownItemProps{}, "Copy"),
				ui.DropdownItem(ui.DropdownItemProps{}, "Paste"),
			),
			g.Div(g.Class("flex flex-wrap items-center gap-3"),
				ui.Tooltip(ui.TooltipProps{Label: "A short hint"}, ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline}, "Hover (tooltip)")),
				ui.HoverCard(ui.HoverCardProps{},
					ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline}, "Hover (card)"),
					ui.Item(ui.ItemMedia(ui.Avatar(ui.AvatarProps{Name: "Grove"})), ui.ItemContent(ui.ItemTitle("@grove"), ui.ItemDescription("Go + wasm UI."))),
				),
			),
			ui.Dialog(ui.DialogProps{Open: dlgOpen, OnClose: func() { setDlg(false) }},
				ui.DialogHeader(ui.DialogTitle("Edit profile"), ui.DialogDescription("Make changes and save.")),
				ui.Input(ui.InputProps{Placeholder: "Name"}),
				ui.DialogFooter(ui.Button(ui.ButtonProps{OnClick: func(*g.Event) { setDlg(false) }}, "Save")),
			),
			ui.AlertDialog(ui.AlertDialogProps{Open: alertOpen, OnClose: func() { setAlert(false) }},
				ui.AlertDialogHeader(ui.AlertDialogTitle("Delete event?"), ui.AlertDialogDescription("This cannot be undone.")),
				ui.AlertDialogFooter(
					ui.AlertDialogCancel(func(*g.Event) { setAlert(false) }, "Cancel"),
					ui.AlertDialogAction(func(*g.Event) { setAlert(false) }, "Delete"),
				),
			),
			ui.Sheet(ui.SheetProps{Open: sheetOpen, OnClose: func() { setSheet(false) }, Side: ui.SheetRight},
				ui.SheetHeader(ui.SheetTitle("Filters"), ui.SheetDescription("Narrow the results.")),
				ui.SheetFooter(ui.Button(ui.ButtonProps{OnClick: func(*g.Event) { setSheet(false) }}, "Apply")),
			),
			ui.Drawer(ui.DrawerProps{Open: drawerOpen, OnClose: func() { setDrawer(false) }},
				ui.DrawerHeader(ui.DrawerTitle("Quick actions"), ui.DrawerDescription("Swipe-up style panel.")),
				ui.DrawerFooter(ui.Button(ui.ButtonProps{OnClick: func(*g.Event) { setDrawer(false) }}, "Done")),
			),
		),

		componentSection("Date & time",
			g.Div(g.Class("flex flex-wrap items-start gap-4"),
				ui.Calendar(ui.CalendarProps{}),
				g.Div(g.Class("flex w-56 flex-col gap-3"),
					ui.DatePicker(ui.DatePickerProps{Placeholder: "Pick a date"}),
					ui.TimePicker(ui.TimePickerProps{Value: &ui.Time{Hour: 9, Minute: 30}}),
				),
			),
		),

		componentSection("Empty state",
			ui.Empty(
				ui.EmptyHeader(
					ui.EmptyMedia(ui.Icon("search", "size-6")),
					ui.EmptyTitle("No results"),
					ui.EmptyDescription("Try adjusting your filters."),
				),
				ui.EmptyContent(ui.Button(ui.ButtonProps{Variant: ui.ButtonOutline, Size: ui.ButtonSizeSm}, "Clear filters")),
			),
		),

		componentSection("Typography",
			ui.TypographyH3("The quick brown fox"),
			ui.TypographyP("Grove renders this paragraph with the design system's prose styles, including ", ui.TypographyInlineCode("inline code"), " and links."),
			ui.TypographyBlockquote("Make it work, make it right, make it fast."),
		),
	)
}

func componentSection(title string, body ...any) *g.Node {
	return g.Section(g.Class("flex flex-col gap-3"),
		g.H3(g.Class("text-xs font-semibold uppercase tracking-wider text-muted-foreground"), title),
		g.Div(append([]any{g.Class("flex flex-col gap-4 rounded-xl border border-border/60 bg-card/40 p-5")}, body...)...),
		ui.Separator(false, g.Class("opacity-0")),
	)
}
