//go:generate go tool warchest generate

// Package app is the overlap UI: a when2meet-style availability matcher
// built on grove. It is platform-agnostic (storage and dark-mode are
// injected), so the whole app is testable with grove/testdom.
package app

import (
	"fmt"
	"time"

	g "github.com/gyoumi/grove"
	"github.com/gyoumi/grove/router"
	"github.com/gyoumi/overlap/schedule"
	"github.com/gyoumi/overlap/ui"
	. "warchest/wc"
)

// Store persists the workspace between sessions. The browser entry point
// backs it with localStorage; tests use an in-memory string.
type Store interface {
	Load() string // "" when nothing is stored
	Save(s string)
}

type Props struct {
	Store Store
	// SetDark applies the app-wide dark class; the browser entry point
	// passes dom.SetRootClass, tests pass a recorder. Nil is allowed.
	SetDark func(bool)
}

// App owns the workspace (all events keyed by id) and routes between the
// home page and individual event grids.
func App(p Props) *g.Node {
	events, setEvents := g.UseStateLazy(func() map[string]schedule.Event {
		return loadWorkspace(p.Store)
	})
	dark, setDark := g.UseState(false)

	g.UseEffect(func() func() {
		if p.SetDark != nil {
			p.SetDark(dark)
		}
		return nil
	}, []any{dark})

	persist := func(m map[string]schedule.Event) {
		setEvents(m)
		schedule.EncodeAll(m).IfOk(p.Store.Save)
	}
	update := func(id string, e schedule.Event) {
		m := cloneEvents(events)
		m[id] = e
		persist(m)
	}
	remove := func(id string) {
		m := cloneEvents(events)
		delete(m, id)
		persist(m)
	}

	return g.Div(g.Class("mx-auto flex min-h-svh max-w-3xl flex-col gap-6 px-6 pb-6 text-foreground"),
		g.Header(g.Class("sticky top-0 z-40 -mx-6 flex items-center justify-between border-b border-border/60 bg-background/75 px-6 py-3 backdrop-blur-md"),
			router.Link("/", g.Class("flex items-center gap-2.5 no-underline"),
				logoMark(),
				g.Span(g.Class("bg-gradient-to-r from-primary to-fuchsia-500 bg-clip-text text-xl font-bold tracking-tight text-transparent"),
					"overlap"),
			),
			g.Div(g.Class("flex items-center gap-3"),
				router.Link("/components", g.Class("hidden text-xs font-medium text-muted-foreground no-underline transition-colors hover:text-foreground sm:block"),
					"components"),
				ui.Tooltip(ui.TooltipProps{Label: "toggle dark mode"},
					ui.Switch(ui.SwitchProps{ID: "dark-mode", Checked: dark, OnChange: setDark}),
				),
			),
		),
		router.Routes(
			router.Route{Pattern: "/", Render: func(router.Params) *g.Node {
				return g.C(HomePage, HomeProps{
					Events: events,
					OnCreate: func(e schedule.Event) {
						id := newID()
						update(id, e)
						router.Navigate("/event/" + id)
					},
				})
			}},
			router.Route{Pattern: "/event/:id", Render: func(params router.Params) *g.Node {
				id := params["id"]
				e, ok := events[id]
				if !ok {
					return missingEvent()
				}
				return g.C(EventView, EventProps{
					Event:    e,
					OnUpdate: func(e schedule.Event) { update(id, e) },
					OnDelete: func() {
						remove(id)
						router.Navigate("/")
					},
				})
			}},
			router.Route{Pattern: "/components", Render: func(router.Params) *g.Node {
				return g.C0(ComponentsPage)
			}},
			router.Route{Pattern: "*", Render: func(router.Params) *g.Node {
				return missingEvent()
			}},
		),
		g.Footer(g.Class("mt-auto flex items-center justify-center gap-1.5 pt-8 text-xs text-muted-foreground"),
			g.Span("built with"),
			g.A(g.Class("font-medium text-foreground/70 transition-colors hover:text-primary"),
				g.Href("https://github.com/gyoumi/grove"), "grove"),
			g.Span("+"),
			g.A(g.Class("font-medium text-foreground/70 transition-colors hover:text-primary"),
				g.Href("https://github.com/gyoumi/warchest-errors"), "warchest"),
		),
	)
}

// logoMark is a 2x2 mini heatmap — the product, four cells big.
func logoMark() *g.Node {
	cell := func(tone string) *g.Node {
		return g.Span(g.Class("size-2 rounded-[3px]", tone))
	}
	return g.Span(g.Class("grid grid-cols-2 gap-0.5 rounded-md border border-border/60 bg-card p-1 shadow-sm"),
		cell("bg-primary/30"), cell("bg-primary/70"),
		cell("bg-primary"), cell("bg-emerald-500"),
	)
}

func missingEvent() *g.Node {
	return g.Div(g.Class("flex flex-col items-start gap-3 animate-rise"),
		g.P(g.Class("text-sm text-muted-foreground"), "That page doesn't exist (anymore)."),
		router.Link("/", g.Class("text-sm font-medium text-primary underline-offset-4 hover:underline"),
			"back to your events"),
	)
}

func loadWorkspace(store Store) map[string]schedule.Event {
	s := store.Load()
	if s == "" {
		return map[string]schedule.Event{}
	}
	return schedule.DecodeAll(s).UnwrapOrElse(func(error) map[string]schedule.Event {
		// migrate a v1 single-event payload into the workspace format,
		// or start fresh when the payload is junk
		return MapResult(schedule.Decode(s), func(e schedule.Event) map[string]schedule.Event {
			return map[string]schedule.Event{newID(): e}
		}).UnwrapOr(map[string]schedule.Event{})
	})
}

func cloneEvents(m map[string]schedule.Event) map[string]schedule.Event {
	out := make(map[string]schedule.Event, len(m)+1)
	for k, v := range m {
		out[k] = v
	}
	return out
}

var idCounter int

func newID() string {
	idCounter++
	return fmt.Sprintf("%x-%d", time.Now().UnixNano()&0xFFFFFF, idCounter)
}

type HomeProps struct {
	Events   map[string]schedule.Event
	OnCreate func(schedule.Event)
}

// HomePage greets first-time visitors with a hero, lists existing events,
// and hosts the creation form.
func HomePage(p HomeProps) *g.Node {
	ids := sortedIDs(p.Events)
	return g.Div(g.Class("flex flex-col gap-6"),
		g.If(len(ids) == 0, hero()),
		g.If(len(ids) > 0,
			g.Div(g.Class("flex flex-col gap-3 animate-rise"),
				g.H2(g.Class("text-lg font-semibold tracking-tight"), "Your events"),
				g.Ul(g.Class("flex flex-col gap-2.5"),
					g.Map(ids, func(id string) *g.Node {
						return eventCard(id, p.Events[id])
					}),
				),
			),
		),
		g.C(SetupForm, SetupProps{OnCreate: p.OnCreate}),
	)
}

func hero() *g.Node {
	return g.Div(g.Class("flex flex-col items-center gap-3 py-10 text-center animate-rise"),
		g.H2(g.Class("max-w-xl text-balance text-4xl font-bold tracking-tight"),
			"Find the time that ",
			g.Span(g.Class("bg-gradient-to-r from-primary via-fuchsia-500 to-emerald-500 bg-clip-text text-transparent"),
				"works for everyone"),
			".",
		),
		g.P(g.Class("max-w-md text-balance text-sm leading-relaxed text-muted-foreground"),
			"Set up the days and hours, let everyone paint when they're free, and watch the overlap light up."),
	)
}

func eventCard(id string, e schedule.Event) *g.Node {
	window := fmt.Sprintf("%s – %s", e.SlotLabel(0), e.SlotLabel(e.SlotsPerDay()-1))
	return g.Li(g.Key(id), g.Class("animate-rise"),
		router.Link("/event/"+id,
			g.Class("group flex items-center justify-between gap-4 rounded-xl border border-border/60 bg-card/70 px-5 py-4 no-underline shadow-sm backdrop-blur transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/10"),
			g.Data("event-link", id),
			g.Div(g.Class("flex flex-col gap-1"),
				g.Span(g.Class("font-semibold text-foreground transition-colors group-hover:text-primary"), e.Name),
				g.Span(g.Class("text-xs text-muted-foreground"),
					g.Textf("%d days · %s", e.Days, window)),
			),
			avatarStack(e.People),
		),
	)
}

func avatarStack(people []schedule.Participant) *g.Node {
	if len(people) == 0 {
		return g.Span(g.Class("text-xs italic text-muted-foreground"), "no one yet")
	}
	const max = 4
	stack := []any{g.Class("flex -space-x-2")}
	for i, person := range people {
		if i == max {
			break
		}
		stack = append(stack, ui.Avatar(ui.AvatarProps{Name: person.Name, Size: ui.AvatarSizeSm}))
	}
	if len(people) > max {
		stack = append(stack, g.Span(
			g.Class("inline-flex size-6 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-muted-foreground ring-2 ring-background"),
			g.Textf("+%d", len(people)-max)))
	}
	return g.Div(stack...)
}

func sortedIDs(m map[string]schedule.Event) []string {
	ids := make([]string, 0, len(m))
	for id := range m {
		ids = append(ids, id)
	}
	for i := 1; i < len(ids); i++ {
		for j := i; j > 0 && m[ids[j]].Name < m[ids[j-1]].Name; j-- {
			ids[j], ids[j-1] = ids[j-1], ids[j]
		}
	}
	return ids
}

type SetupProps struct {
	OnCreate func(schedule.Event)
}

// SetupForm collects the event parameters and validates them through
// schedule.ParseForm; the typed ValidationError drives the inline message.
func SetupForm(p SetupProps) *g.Node {
	name, setName := g.UseState("")
	rangeStart, setRangeStart := g.UseState[*ui.Date](nil)
	rangeEnd, setRangeEnd := g.UseState[*ui.Date](nil)
	startTime, setStartTime := g.UseState(ui.Time{Hour: 9})
	endTime, setEndTime := g.UseState(ui.Time{Hour: 17})
	errMsg, setErrMsg := g.UseState("")

	// The pickers guarantee a valid date, day count, and times, but
	// ParseForm stays the single validation seam: the derived strings get
	// the same bounds checks (incl. the 1-14 day cap and end-after-start)
	// and `?` pipeline as before. An unpicked range yields an empty date,
	// which ParseForm reports after the name check.
	create := func(*g.Event) {
		date, days := "", ""
		if rangeStart != nil && rangeEnd != nil {
			date = rangeStart.ISO()
			days = fmt.Sprint(ui.DaysBetween(*rangeStart, *rangeEnd) + 1)
		}
		schedule.ParseForm(name, date, days, startTime.String(), endTime.String()).
			IfErr(func(verr schedule.ValidationError) { setErrMsg(verr.Error()) }).
			IfOk(p.OnCreate)
	}

	labeled := func(label string, control *g.Node) *g.Node {
		return g.Div(g.Class("flex flex-col gap-1.5"), ui.Label("", label), control)
	}

	return ui.Card(g.Class("border-border/60 bg-card/70 shadow-xl shadow-primary/5 backdrop-blur animate-rise"),
		ui.CardHeader(
			ui.CardTitle("New event"),
			ui.CardDescription("Pick the days and hours people should mark themselves available for."),
		),
		ui.CardContent(g.Class("flex flex-col gap-4"),
			labeled("Event name",
				ui.Input(ui.InputProps{ID: "name", Value: name, OnInput: func(e *g.Event) { setName(e.Value()) }})),
			g.Div(g.Class("grid gap-4 sm:grid-cols-2"),
				labeled("Day range",
					ui.DatePicker(ui.DatePickerProps{
						Mode:        ui.CalendarRange,
						Start:       rangeStart,
						End:         rangeEnd,
						Placeholder: "Pick the day range",
						OnRange: func(s, e ui.Date) {
							ss, ee := s, e
							setRangeStart(&ss)
							setRangeEnd(&ee)
							setErrMsg("")
						},
					})),
				g.Div(g.Class("grid grid-cols-2 gap-3"),
					labeled("From",
						ui.TimePicker(ui.TimePickerProps{
							Value:    &startTime,
							OnChange: func(t ui.Time) { setStartTime(t); setErrMsg("") },
						})),
					labeled("To",
						ui.TimePicker(ui.TimePickerProps{
							Value:    &endTime,
							OnChange: func(t ui.Time) { setEndTime(t); setErrMsg("") },
						})),
				),
			),
			g.If(errMsg != "",
				g.P(g.Class("text-sm font-medium text-destructive animate-pop"), g.Data("slot", "form-error"), errMsg),
			),
		),
		ui.CardFooter(
			ui.Button(ui.ButtonProps{OnClick: create}, "Create event"),
		),
	)
}
