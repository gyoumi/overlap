//go:generate go tool warchest generate

// Package app is the overlap UI: a when2meet-style availability matcher
// built on grove. It is platform-agnostic (storage and dark-mode are
// injected), so the whole app is testable with grove/testdom.
//
// Files are organised one component per file: the shell and router live
// here, each page has its own file (home, setup_form, event*), workspace
// persistence sits in workspace, and the component gallery is its own
// package (github.com/gyoumi/overlap/gallery).
package app

import (
	g "github.com/gyoumi/grove"
	"github.com/gyoumi/grove/router"
	"github.com/gyoumi/overlap/gallery"
	"github.com/gyoumi/overlap/schedule"
	"github.com/gyoumi/overlap/ui"
)

// Store persists the workspace between sessions. The browser entry point
// backs it with localStorage; tests use an in-memory string.
type Store interface {
	Load() string // "" when nothing is stored
	Save(s string)
}

type Props struct {
	Store Store
	// SetDark applies the app-wide dark class; the browser entry point
	// passes dom.SetRootClass, tests pass a recorder. Nil is allowed.
	SetDark func(bool)
}

// App owns the workspace (all events keyed by id) and routes between the
// home page and individual event grids.
func App(p Props) *g.Node {
	events, setEvents := g.UseStateLazy(func() map[string]schedule.Event {
		return loadWorkspace(p.Store)
	})
	dark, setDark := g.UseState(false)

	g.UseEffect(func() func() {
		if p.SetDark != nil {
			p.SetDark(dark)
		}
		return nil
	}, []any{dark})

	persist := func(m map[string]schedule.Event) {
		setEvents(m)
		schedule.EncodeAll(m).IfOk(p.Store.Save)
	}
	update := func(id string, e schedule.Event) {
		m := cloneEvents(events)
		m[id] = e
		persist(m)
	}
	remove := func(id string) {
		m := cloneEvents(events)
		delete(m, id)
		persist(m)
	}

	return g.Div(g.Class("mx-auto flex min-h-svh max-w-3xl flex-col gap-6 px-6 pb-6 text-foreground"),
		g.Header(g.Class("sticky top-0 z-40 -mx-6 flex items-center justify-between border-b border-border/60 bg-background/75 px-6 py-3 backdrop-blur-md"),
			router.Link("/", g.Class("flex items-center gap-2.5 no-underline"),
				logoMark(),
				g.Span(g.Class("bg-gradient-to-r from-primary to-fuchsia-500 bg-clip-text text-xl font-bold tracking-tight text-transparent"),
					"overlap"),
			),
			g.Div(g.Class("flex items-center gap-3"),
				router.Link("/components", g.Class("hidden text-xs font-medium text-muted-foreground no-underline transition-colors hover:text-foreground sm:block"),
					"components"),
				ui.Tooltip(ui.TooltipProps{Label: "toggle dark mode"},
					ui.Switch(ui.SwitchProps{ID: "dark-mode", Checked: dark, OnChange: setDark}),
				),
			),
		),
		router.Routes(
			router.Route{Pattern: "/", Render: func(router.Params) *g.Node {
				return g.C(HomePage, HomeProps{
					Events: events,
					OnCreate: func(e schedule.Event) {
						id := newID()
						update(id, e)
						ui.Toast("Event created", ui.ToastOptions{Description: "Add people and start painting.", Variant: ui.ToastSuccess})
						router.Navigate("/event/" + id)
					},
				})
			}},
			router.Route{Pattern: "/event/:id", Render: func(params router.Params) *g.Node {
				id := params["id"]
				e, ok := events[id]
				if !ok {
					return missingEvent()
				}
				return g.C(EventView, EventProps{
					Event:    e,
					OnUpdate: func(e schedule.Event) { update(id, e) },
					OnDelete: func() {
						remove(id)
						ui.Toast("Event deleted")
						router.Navigate("/")
					},
				})
			}},
			router.Route{Pattern: "/components", Render: func(router.Params) *g.Node {
				return g.C0(gallery.Page)
			}},
			router.Route{Pattern: "*", Render: func(router.Params) *g.Node {
				return missingEvent()
			}},
		),
		g.Footer(g.Class("mt-auto flex items-center justify-center gap-1.5 pt-8 text-xs text-muted-foreground"),
			g.Span("built with"),
			g.A(g.Class("font-medium text-foreground/70 transition-colors hover:text-primary"),
				g.Href("https://github.com/gyoumi/grove"), "grove"),
			g.Span("+"),
			g.A(g.Class("font-medium text-foreground/70 transition-colors hover:text-primary"),
				g.Href("https://github.com/gyoumi/warchest-errors"), "warchest"),
		),
		ui.Toaster(),
	)
}

// logoMark is a 2x2 mini heatmap — the product, four cells big.
func logoMark() *g.Node {
	cell := func(tone string) *g.Node {
		return g.Span(g.Class("size-2 rounded-[3px]", tone))
	}
	return g.Span(g.Class("grid grid-cols-2 gap-0.5 rounded-md border border-border/60 bg-card p-1 shadow-sm"),
		cell("bg-primary/30"), cell("bg-primary/70"),
		cell("bg-primary"), cell("bg-emerald-500"),
	)
}

func missingEvent() *g.Node {
	return g.Div(g.Class("flex flex-col items-start gap-3 animate-rise"),
		g.P(g.Class("text-sm text-muted-foreground"), "That page doesn't exist (anymore)."),
		router.Link("/", g.Class("text-sm font-medium text-primary underline-offset-4 hover:underline"),
			"back to your events"),
	)
}
