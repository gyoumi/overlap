package schedule

import (
	"encoding/json"
	"fmt"
	"strconv"
	"strings"
	"time"

	. "warchest/wc"
)

// ParseForm validates raw form input into an Event. The error type names
// the only failure mode this can produce, and each `?` below propagates it.
func ParseForm(name, startDate, days, startHour, endHour string) Result[Event, ValidationError] {
	trimmed := strings.TrimSpace(name)
	if trimmed == "" {
		return Err[Event](ValidationError{Field: "name", Msg: "give the event a name"})
	}
	if _, err := time.Parse("2006-01-02", strings.TrimSpace(startDate)); err != nil {
		return Err[Event](ValidationError{Field: "start date", Msg: "use YYYY-MM-DD"})
	}
	d := parseRange(days, "days", 1, 14)?
	sh := parseRange(startHour, "start hour", 0, 23)?
	eh := parseRange(endHour, "end hour", 1, 24)?
	if eh <= sh {
		return Err[Event](ValidationError{Field: "end hour", Msg: "must be after the start hour"})
	}
	return Ok(Event{
		Name:      trimmed,
		StartDate: strings.TrimSpace(startDate),
		Days:      d,
		StartHour: sh,
		EndHour:   eh,
	})
}

func parseRange(s, field string, lo, hi int) Result[int, ValidationError] {
	n, err := strconv.Atoi(strings.TrimSpace(s))
	if err != nil {
		return Err[int](ValidationError{Field: field, Msg: "not a number"})
	}
	if n < lo || n > hi {
		return Err[int](ValidationError{Field: field, Msg: fmt.Sprintf("must be between %d and %d", lo, hi)})
	}
	return Ok(n)
}

// DayLabels formats each day of the event, e.g. "Mon 6/15".
func DayLabels(e Event) Result[[]string, error] {
	start := time.Parse("2006-01-02", e.StartDate)?
	labels := make([]string, e.Days)
	for i := range labels {
		labels[i] = start.AddDate(0, 0, i).Format("Mon 1/2")
	}
	return Ok(labels)
}

// Encode serializes an event for storage.
func Encode(e Event) Result[string, error] {
	b := json.Marshal(e)?
	return Ok(string(b))
}

// Decode parses a stored event.
func Decode(s string) Result[Event, error] {
	var e Event
	if err := json.Unmarshal([]byte(s), &e); err != nil {
		return Err[Event](err)
	}
	return Ok(e)
}

// FindParticipant looks a participant up by name.
func FindParticipant(e Event, name string) Option[Participant] {
	for _, p := range e.People {
		if p.Name == name {
			return Some(p)
		}
	}
	return None[Participant]()
}

// ParseKey parses a SlotKey back into its grid coordinates; None for
// malformed keys. `?` on an Option short-circuits with None.
func ParseKey(key string) Option[SlotRef] {
	parts := strings.Split(key, ":")
	if len(parts) != 2 {
		return None[SlotRef]()
	}
	day := atoiOpt(parts[0])?
	slot := atoiOpt(parts[1])?
	return Some(SlotRef{Day: day, Slot: slot})
}

func atoiOpt(s string) Option[int] {
	n, err := strconv.Atoi(s)
	if err != nil {
		return None[int]()
	}
	return Some(n)
}

// Best returns the slot where the most people align, or None when nobody
// has painted any availability yet. Earlier slots win ties.
func Best(e Event) Option[BestSlot] {
	best := BestSlot{Total: len(e.People)}
	for day := 0; day < e.Days; day++ {
		for slot := 0; slot < e.SlotsPerDay(); slot++ {
			key := SlotKey(day, slot)
			if c := e.CountAt(key); c > best.Count {
				best.Key, best.Count = key, c
			}
		}
	}
	if best.Count == 0 {
		return None[BestSlot]()
	}
	return Some(best)
}
